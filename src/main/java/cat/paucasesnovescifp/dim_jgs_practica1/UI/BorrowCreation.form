        </Component>
        <Component class="javax.swing.JComboBox" name="gameField">
          <Properties>
            <Property name="model" type="javax.swing.ComboBoxModel" editor="org.netbeans.modules.form.RADConnectionPropertyEditor">
              <Connection code="new javax.swing.DefaultComboBoxModel&lt;&gt;(games)" type="code"/>
            </Property>
            <Property name="minimumSize" type="java.awt.Dimension" editor="org.netbeans.beaninfo.editors.DimensionEditor">
              <Dimension value="[64, 22]"/>
            </Property>
          </Properties>
          <Events>
            <EventHandler event="itemStateChanged" listener="java.awt.event.ItemListener" parameters="java.awt.event.ItemEvent" handler="gameFieldItemStateChanged"/>
            <EventHandler event="actionPerformed" listener="java.awt.event.ActionListener" parameters="java.awt.event.ActionEvent" handler="gameFieldActionPerformed"/>
          </Events>
          <AuxValues>
            <AuxValue name="JavaCodeGenerator_InitCodePre" type="java.lang.String" value="List&lt;Game&gt; tempGameList = GameList.getList();&#xa;String[] games = new String[tempGameList.size() + 1];&#xa;for(int i = 0; i &lt; tempGameList.size() + 1; i++){&#xa;    if(i == 0){&#xa;        games[i] = &quot;Seleccionar joc&quot;;&#xa;    }&#xa;    else{&#xa;        games[i] = tempGameList.get(i-1).getName();&#xa;    }&#xa;}"/>
            <AuxValue name="JavaCodeGenerator_TypeParameters" type="java.lang.String" value="&lt;String&gt;"/>
          </AuxValues>
        </Component>
