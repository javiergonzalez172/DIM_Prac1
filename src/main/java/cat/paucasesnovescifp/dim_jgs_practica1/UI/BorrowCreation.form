        <Component class="javax.swing.JComboBox" name="userField">
          <Properties>
            <Property name="model" type="javax.swing.ComboBoxModel" editor="org.netbeans.modules.form.RADConnectionPropertyEditor">
              <Connection code="new javax.swing.DefaultComboBoxModel&lt;&gt;(users)" type="code"/>
            </Property>
            <Property name="minimumSize" type="java.awt.Dimension" editor="org.netbeans.beaninfo.editors.DimensionEditor">
              <Dimension value="[64, 22]"/>
            </Property>
          </Properties>
          <AuxValues>
            <AuxValue name="JavaCodeGenerator_InitCodePre" type="java.lang.String" value="List&lt;User&gt; tempUserList = UserList.getList();&#xa;String[] users = new String[tempUserList.size() + 1];&#xa;for(int i = 0; i &lt; tempUserList.size() + 1; i++){&#xa;    if(i == 0){&#xa;        users[i] = &quot;Seleccionar usuari&quot;;&#xa;    }&#xa;    else{&#xa;        users[i] = tempUserList.get(i-1).getName();&#xa;    }&#xa;}"/>
            <AuxValue name="JavaCodeGenerator_TypeParameters" type="java.lang.String" value="&lt;String&gt;"/>
          </AuxValues>
        </Component>
        <Component class="javax.swing.JLabel" name="gameLabel">
